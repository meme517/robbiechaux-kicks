{
  "name": "@robbiechaux/server",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Robbiechaux Kicks API — approved inventory + verified provider metadata",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx src/scripts/seedDemoInventory.ts",
    "import:search": "tsx src/scripts/importSearch.ts",
    "import:approve": "tsx src/scripts/approveCandidate.ts",
    "import:api": "tsx src/scripts/importApiCatalog.ts",
    "import:wishlist": "tsx src/scripts/importWishlist.ts",
    "images:manifest": "tsx src/scripts/syncProductImages.ts --manifest",
    "images:sync": "tsx src/scripts/syncProductImages.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongodb": "^6.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
