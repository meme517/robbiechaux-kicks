# =============================================================================
# Robbiechaux Kicks — SERVER environment variables (backend only)
# Copy to server/.env  (NEVER commit the real .env — it is gitignored)
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# --- MongoDB -----------------------------------------------------------------
# Default local database for this project.
MONGODB_URI=mongodb://localhost:27017/robbie_shoes
MONGODB_DB=robbie_shoes

# --- KicksDB provider (server-side secret; NEVER a VITE_ variable) -----------
# Create an account at https://kicks.dev/register and copy the key from
# https://kicks.dev/api-keys . Leave blank to run with an honest
# "Catalog setup pending" state (no live provider requests are attempted).
KICKSDB_API_KEY=

# --- Google Shopping via SerpApi (optional alternate source) -----------------
# Free tier: 250 searches/month. Store the key only on the server.
# https://serpapi.com/users/sign_up
SERPAPI_API_KEY=
SERPAPI_TIMEOUT_MS=15000

# Provider base URL (configurable so provider changes need no code edit).
# KicksDB migrated its StockX endpoints to the pckt.sh data layer; the public
# base URL is unchanged. Verify at https://docs.kicks.dev/guides before changing.
PROVIDER_BASE_URL=https://api.kicks.dev/v3
PROVIDER_TIMEOUT_MS=8000
PROVIDER_CACHE_TTL_SECONDS=86400
PROVIDER_MARKET=US

# --- Provider IMAGE-USE terms -------------------------------------------------
# Set true ONLY after you have read the provider's current image-use terms and
# confirmed your plan permits displaying catalog imagery on your storefront.
PROVIDER_IMAGE_USE_APPROVED=false
# Attribution text shown next to provider-sourced imagery.
PROVIDER_IMAGE_ATTRIBUTION=Product imagery via StockX (via KicksDB)
# Attribution for imagery imported from the catalog source below.
CATALOG_IMAGE_ATTRIBUTION=Product imagery via DummyJSON (dummyjson.com)

# --- Catalog source (used while KICKSDB_API_KEY is blank) ---------------------
# Key-free source the `npm run import:api` workflow pulls REAL product images
# from, so the storefront never shows locally drawn placeholder SVGs.
CATALOG_API_BASE_URL=https://dummyjson.com
CATALOG_API_TIMEOUT_MS=8000
# OWNER: conversion applied to the source catalog's USD price so a product can
# be published at all. Stored per record and fully editable — replace with your
# own RWF selling prices as soon as you have them.
USD_TO_RWF_RATE=1300

# --- Contact form email provider (optional) -----------------------------------
# While these are blank the API reports the form as unavailable and the UI
# offers phone/WhatsApp instead (it never shows a false "Message sent").
CONTACT_PROVIDER=
CONTACT_ENDPOINT=
CONTACT_API_KEY=
CONTACT_TO_EMAIL=

# --- Owner/admin tools --------------------------------------------------------
# Shared secret for the protected admin endpoints (GET /api/admin/products,
# POST /api/admin/verify-provider). Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
