# =============================================================================
# Robbiechaux Kicks — CLIENT environment variables (browser bundle)
# Copy to client/.env  (gitignored)
# =============================================================================
# NEVER put secrets here — anything with a VITE_ prefix is shipped to the
# browser. The KICKSDB_API_KEY belongs in server/.env only.

# Base URL of the Robbiechaux Kicks API (our backend, not the provider).
# Leave blank to use the dev proxy default (http://localhost:3000).
VITE_API_BASE_URL=http://localhost:3000

# Catalog source:
#   'api'      -> read the live store API (default for Phase 2)
#   'demo'     -> use the clearly-labelled demo records (design preview only,
#                 never sends real orders)
VITE_CATALOG_MODE=api
